class Solution {
  public:
    void reverseArray(vector<int> &arr) {
        int n = arr.size();
        int left = 0;
        int right = n - 1;

        // Swap elements from both ends
        while(left < right) {
            int temp = arr[left];
            arr[left] = arr[right];
            arr[right] = temp;

            left++;
            right--;
        }
    }
};
