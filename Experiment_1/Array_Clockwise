class Solution {
  public:
    void rotate(vector<int> &arr) {
        int n = arr.size();
        
        if(n <= 1) return;  // Edge case
        
        int temp = arr[n - 1];  // Store last element
        
        // Shift elements to right
        for(int i = n - 1; i > 0; i--) {
            arr[i] = arr[i - 1];
        }
        
        arr[0] = temp;  // Put last element at first
    }
};
